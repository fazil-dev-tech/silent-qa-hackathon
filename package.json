{
  "name": "silent-qa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Silent QA: Browser flight recorder and AI defect report engine",
  "workspaces": [
    "packages/*",
    "apps/*",
    "demo-shop"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "dev:web": "npm run --workspace=@silent-qa/web dev",
    "dev:demo": "npm run --workspace=@silent-qa/demo-shop dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
